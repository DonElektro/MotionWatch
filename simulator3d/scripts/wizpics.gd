static func texture(key: String, scale := 1.0) -> Texture2D:
	if not PICS.has(key):
		return null
	var img := Image.new()
	if img.load_svg_from_string(PICS[key], scale) != OK:
		return null
	return ImageTexture.create_from_image(img)

