; Motion Watch 3D simulator (Godot 4.3)
config_version=5

[application]

config/name="Motion Watch 3D Simulator"
config/icon="res://icon_sim3d.png"
config/description="3D simulation for Motion Watch: cameras on a pan/tilt head, thermal camera, lights, weather, visitors"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3")
run/low_processor_mode=false

[display]

window/size/viewport_width=1440
window/size/viewport_height=860
window/stretch/mode="disabled"
window/vsync/vsync_mode=1

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.08, 1)

[physics]

common/physics_ticks_per_second=30
