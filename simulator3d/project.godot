; MoveEye Sim 3D (Godot 4.3) - until 3D-4.23 «Motion Watch 3D Simulator»; config/name is also the folder of the user data (user://)
config_version=5

[application]

config/name="MoveEye Sim 3D"
config/icon="res://icon_sim3d.png"
config/description="3D simulation for MoveEye: cameras on a pan/tilt head, thermal camera, lights, weather, visitors"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3")
run/low_processor_mode=false
boot_splash/bg_color=Color(0.043, 0.071, 0.125, 1)
boot_splash/image="res://ruhebild_start.png"
boot_splash/fullsize=true
boot_splash/use_filter=true

[audio]

general/text_to_speech=true

[display]

window/size/viewport_width=1440
window/size/viewport_height=860
window/stretch/mode="disabled"
window/vsync/vsync_mode=1

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.arm64="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
; Browser: die Hauptansicht ohne MSAA ab dem ersten Bild (Grafikspeicher iPhone / iPad, Besitzer 23.11.2026); die Stufen
; «mittel» und höher schalten es danach wie bisher wieder ein (main_start._apply_quality)
anti_aliasing/quality/msaa_3d.web=0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.08, 1)
; Browser (Godot 4.3 Web ohne Threads): ab 1000 Dingen in der Welt sortiert Godot «mit Threads» aus - ohne Threads bleibt
; dann gar nichts übrig (nur Himmel und Boden zu sehen, Besitzer 15.11.2026 iPhone). Im Browser darum nie mit Threads.
limits/spatial_indexer/threaded_cull_minimum_instances.web=1000000

[physics]

common/physics_ticks_per_second=30
