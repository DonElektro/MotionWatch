 #endif
 }
 
+// MoveEye: a page that starts one game sets Module["quitAfterGame"]: when the game ends (quit, give up, end of the game,
+// «return to launcher», a game that cannot be started) ScummVM ends instead of opening its launcher, and tells the page.
+EM_JS(int, moveeyeQuitAfterGame, (), {
+	return Module["quitAfterGame"] ? 1 : 0;
+});
+
+EM_JS(void, moveeyeEnded, (int code), {
+	if (Module["onScummvmEnded"]) Module["onScummvmEnded"](code);
+});
+
+// MoveEye: an error message of ScummVM (error(): the game cannot go on) goes to the page, which shows it and keeps it;
+// without a page hook the message box of SDL comes as before.
+EM_JS(int, moveeyeMessage, (int isError, const char *message), {
+	if (!Module["onScummvmMessage"]) return 0;
+	return Module["onScummvmMessage"](isError, UTF8ToString(message)) ? 1 : 0;
+});
+
+void OSystem_Emscripten::messageBox(LogMessageType::Type type, const char *message) {
+	if (moveeyeMessage(type == LogMessageType::kError ? 1 : 0, message))
+		return;
+	OSystem_POSIX::messageBox(type, message);
+}
